<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tftc.lch.security.domain.user.PasswordResetRepository">
  <resultMap id="prMap" type="tftc.lch.security.domain.user.PasswordReset">
    <id property="id" column="id"/>
    <result property="contactType" column="contact_type"/>
    <result property="contactValue" column="contact_value"/>
    <result property="code" column="verify_code"/>
    <result property="expiresAt" column="expired_at"/>
    <result property="lastSentAt" column="created_at"/>
    <result property="used" column="is_used"/>
    <result property="requestIp" column="contact_value"/>
    <result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
  </resultMap>
  <select id="findLatestByContact" resultMap="prMap">
    SELECT * FROM password_reset WHERE contact_type=#{contactType} AND contact_value=#{contactValue} ORDER BY created_at DESC LIMIT 1
  </select>
  <select id="findValidCode" resultMap="prMap">
    SELECT * FROM password_reset WHERE contact_value=#{contactValue} AND verify_code=#{code} AND is_used=0 AND expired_at > NOW() ORDER BY created_at DESC LIMIT 1
  </select>
  <select id="findLatestByUserId" resultMap="prMap">
    SELECT * FROM password_reset WHERE user_id=#{userId} ORDER BY created_at DESC LIMIT 1
  </select>
  <select id="countRecentByUserId" resultType="int">
    SELECT COUNT(*) FROM password_reset WHERE user_id=#{userId} AND created_at > NOW() - INTERVAL #{minutes} MINUTE
  </select>
  <insert id="save" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO password_reset(user_id,contact_type,contact_value,verify_code,is_used,expired_at,created_at,updated_at)
    VALUES(0,#{contactType},#{contactValue},#{code},#{used},#{expiresAt},NOW(),NOW())
  </insert>
</mapper>
