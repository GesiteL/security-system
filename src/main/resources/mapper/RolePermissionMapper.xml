<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tftc.lch.security.domain.role.RolePermissionRepository">
  <resultMap id="rpMap" type="tftc.lch.security.domain.role.RolePermission">
    <id property="id" column="id"/>
    <result property="roleId" column="role_id"/>
    <result property="permissionId" column="function_id"/>
    <result property="planEffectiveAt" column="plan_effective_at"/>
    <result property="planExpiredAt" column="plan_expired_at"/>
    <result property="isDeleted" column="is_deleted"/>
    <result property="deletedToken" column="deleted_token"/>
    <result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
  </resultMap>
  <select id="findById" resultMap="rpMap">SELECT * FROM role_permission WHERE id=#{grantId}</select>
  <select id="findByRoleId" resultMap="rpMap">
    SELECT rp.* FROM role_permission rp JOIN sys_function p ON p.id=rp.function_id WHERE rp.role_id=#{roleId} AND rp.is_deleted=0
    <if test="functionNameKeyword!=null and functionNameKeyword!=''">AND p.function_name LIKE CONCAT('%',#{functionNameKeyword},'%')</if>
  </select>
  <select id="existsByRoleIdAndPermissionId" resultType="boolean">SELECT COUNT(*)>0 FROM role_permission WHERE role_id=#{roleId} AND function_id=#{permissionId} AND is_deleted=0</select>
  <select id="existsActivePermission" resultType="boolean">
    SELECT COUNT(*)>0 FROM user_role ur JOIN role_permission rp ON ur.role_id=rp.role_id AND rp.is_deleted=0 JOIN sys_function p ON p.id=rp.function_id AND p.is_deleted=0 WHERE ur.user_id=#{userId} AND ur.is_deleted=0 AND p.module=#{permCode}
  </select>
  <insert id="save" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO role_permission(role_id,function_id,is_deleted,deleted_token,plan_effective_at,plan_expired_at,created_at,updated_at)
    VALUES(#{roleId},#{permissionId},#{isDeleted},#{deletedToken},#{planEffectiveAt},#{planExpiredAt},NOW(),NOW())
  </insert>
  <update id="update">
    UPDATE role_permission SET is_deleted=#{isDeleted},deleted_token=#{deletedToken},updated_at=NOW() WHERE id=#{id}
  </update>
</mapper>
